# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase Project URL (public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public - safe for frontend)
# This key has RLS enabled and is safe to expose
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# N8N WEBHOOKS CONFIGURATION
# ============================================
# Webhook URL for updating Bling products
VITE_N8N_BLING_UPDATE_WEBHOOK_URL=https://hookn8n.alobexpress.com.br/webhook/664105d0-3f73-4ae7-8ca5-0fe098da45fd

# ============================================
# GENDERIZE.IO API CONFIGURATION
# ============================================
# Genderize.io API Key (optional - free tier available without key)
# Get your API key from: https://store.genderize.io
# Free tier: 1000 requests/day without key
# With key: Higher rate limits and better performance
VITE_GENDERIZE_API_KEY=your_genderize_api_key_here

# Gender classification confidence threshold (0.0 to 1.0)
# Only classifications above this threshold will be saved
# Recommended: 0.80 (80% confidence)
VITE_GENDER_CLASSIFICATION_THRESHOLD=0.80

# ============================================
# MELHOR ENVIO API CONFIGURATION (Task 3.9)
# ============================================
# Melhor Envio API Token for shipping calculation
# Get your token from: https://melhorenvio.com.br/painel/gerenciar/tokens
# Required for calculating shipping costs for Mercado Livre products ≥ R$ 79,00
# Scopes needed: shipping-calculate, shipping-companies
VITE_MELHOR_ENVIO_TOKEN=your_token_here

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit the actual .env file
# 2. Service Role Key should ONLY be used in:
#    - Backend services
#    - N8N workflows (as environment variables)
#    - Server-side operations
# 3. The ANON key is safe for frontend use
# 4. Get your keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# 5. Melhor Envio token is required for shipping calculation on Mercado Livre products ≥ R$ 79,00
