# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase Project URL (public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public - safe for frontend)
# This key has RLS enabled and is safe to expose
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# N8N WEBHOOKS CONFIGURATION
# ============================================
# Webhook URL for updating Bling products
VITE_N8N_BLING_UPDATE_WEBHOOK_URL=https://hookn8n.alobexpress.com.br/webhook/664105d0-3f73-4ae7-8ca5-0fe098da45fd

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit the actual .env file
# 2. Service Role Key should ONLY be used in:
#    - Backend services
#    - N8N workflows (as environment variables)
#    - Server-side operations
# 3. The ANON key is safe for frontend use
# 4. Get your keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
