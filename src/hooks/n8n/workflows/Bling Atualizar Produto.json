        "jsCode": "const fornecedores = $input.first().json.data || [];\nconst dogma = fornecedores.find(function(f) { return f.codigo === 'ALOBFOR_DROP_02'; });\nconst tyr = fornecedores.find(function(f) { return f.codigo === 'ALOBFOR_DROP_01'; });\nconst fornecedor = dogma || tyr || null;\nconsole.log('Fornecedor identificado:', fornecedor ? fornecedor.codigo : 'nenhum');\nreturn [{ json: { fornecedor: fornecedor } }];"
