      "name": "IF Tem Variacoes2"
    },
    {
      "parameters": {
        "jsCode": "const det = $('GET Detalhes Produto2').item.json.data;\nconst token = $('Get Valid Token2').item.json.access_token;\nlet variacoes = [];\ntry {\n  const varResp = await this.helpers.httpRequest({ method: 'GET',\n    url: 'https://api.bling.com.br/Api/v3/produtos/variacoes/' + det.id,\n    headers: { 'Authorization': 'Bearer ' + token, 'Accept': 'application/json' } });\n  variacoes = (varResp && varResp.data && varResp.data.variacoes) ? varResp.data.variacoes : [];\n} catch(e) { return [{ json: { variacoes: [] } }]; }\nfunction sleep(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }\nconst variacoesCompletas = [];\nfor (var i = 0; i < variacoes.length; i++) {\n  var v = variacoes[i];\n  if (i > 0) { await sleep(400); }\n  try {\n    const r = await this.helpers.httpRequest({ method: 'GET',\n      url: 'https://api.bling.com.br/Api/v3/produtos/' + v.id,\n      headers: { 'Authorization': 'Bearer ' + token, 'Accept': 'application/json' } });\n    if (r && r.data) { variacoesCompletas.push(r.data); }\n  } catch(e) { console.log('Error fetching variacao', v.id, ':', e.message); }\n}\nreturn [{ json: { variacoes: variacoesCompletas } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        110496,
        35056
      ],
      "id": "0f1d0e6c-205a-402a-b411-351186cb59db",
      "name": "GET Variacoes2"
    },
    {
      "parameters": {
        "jsCode": "const sku = $('Webhook2').item.json.body.sku;\nconst produtoId = $('GET Produto por SKU2').item.json.data[0].id;\nconst token = $('Get Valid Token2').item.json.access_token;\nconst det = $('GET Detalhes Produto2').item.json.data;\nconst salePrice = $('Webhook2').item.json.body.sellingPrice ? Number($('Webhook2').item.json.body.sellingPrice) : null;\nif (!salePrice) { return [{ json: { skipped: true, reason: 'no_price', sku: sku } }]; }\nfunction sleep(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }\n// Faz PUT preservando todos os campos do produto, alterando apenas o preco\nasync function putComPreco(url, prodData) {\n  // Clona o objeto e atualiza apenas o preco\n  var body = JSON.parse(JSON.stringify(prodData));\n  body.preco = salePrice;\n  // Remove campos que a API nao aceita no PUT\n  delete body.id;\n  delete body.estoque;\n  delete body.fornecedor;\n  delete body.categoria;\n  try {\n    const resp = await this.helpers.httpRequest({ method: 'PUT', url: url,\n      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json', 'Accept': 'application/json' },\n      body: body, returnFullResponse: true, ignoreHttpStatusErrors: true });\n    if (resp.statusCode >= 400) console.log('PUT ERRO', url.split('/').pop(), resp.statusCode, JSON.stringify(resp.body||{}).substring(0,400));\n    return resp.statusCode;\n  } catch(e) { console.log('PUT exception:', e.message); return 500; }\n}\n// Produto com variacoes: atualiza preco do PAI e de cada variacao\nif (det.formato === 'V') {\n  let variacoesData = [];\n  try { variacoesData = $('GET Variacoes2').item.json.variacoes || []; } catch(e) {}\n  if (variacoesData.length === 0) { return [{ json: { error: 'variacoes_vazias', sku: sku } }]; }\n  // Atualiza o produto pai primeiro\n  var paiStatus = await putComPreco.call(this, 'https://api.bling.com.br/Api/v3/produtos/' + produtoId, det);\n  console.log('PUT pai status:', paiStatus);\n  await sleep(400);\n  // Atualiza cada variacao\n  var ok = 0, erros = [];\n  for (var i = 0; i < variacoesData.length; i++) {\n    if (i > 0) { await sleep(400); }\n    var status = await putComPreco.call(this, 'https://api.bling.com.br/Api/v3/produtos/' + variacoesData[i].id, variacoesData[i]);\n    if (status < 400) { ok++; } else { erros.push({ codigo: variacoesData[i].codigo, status: status }); }\n  }\n  return [{ json: { success: ok > 0, paiStatus: paiStatus, updated: ok, errors: erros, total: variacoesData.length, sku: sku } }];\n}\n// Produto simples: reenvia dados completos com preco atualizado\nvar status = await putComPreco.call(this, 'https://api.bling.com.br/Api/v3/produtos/' + produtoId, det);\nif (status >= 400) { return [{ json: { error: 'PUT falhou', status: status, sku: sku } }]; }\nreturn [{ json: { success: true, sku: sku, preco: salePrice } }];"
      },
