    {
      "parameters": {
        "jsCode": "const sku = $('Webhook2').item.json.body.sku;\nconst produtoId = $('GET Produto por SKU2').item.json.data[0].id;\nconst token = $('Get Valid Token2').item.json.access_token;\nconst supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9lbnNxaGpueHdwY3Vhbm96c2tlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NjQxMzI3MiwiZXhwIjoyMDgxOTg5MjcyfQ.yyp6TzvCGA3yl0SdPveR0y86cxRSeCyUTjQtBoJt5Bg';\nconst baseUrl = 'https://oensqhjnxwpcuanozske.supabase.co/rest/v1';\nconst sbResult = await this.helpers.httpRequest({ method: 'GET',\n  url: baseUrl + '/products_bling?sku=eq.' + encodeURIComponent(sku) + '&select=cost_price',\n  headers: { 'apikey': supabaseKey, 'Authorization': 'Bearer ' + supabaseKey } });\nconst costPrice = sbResult && sbResult[0] ? sbResult[0].cost_price : 0;\nconst contatoData = $('GET Contato Fornecedor2').item.json;\nconst idFornecedor = contatoData.data && contatoData.data[0] ? contatoData.data[0].id : null;\nif (!idFornecedor) { return [{ json: { skipped: true, reason: 'supplier_not_found', sku: sku } }]; }\nconst result = await this.helpers.httpRequest({ method: 'POST',\n  url: 'https://api.bling.com.br/Api/v3/produtos/fornecedores',\n  headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json', 'Accept': 'application/json' },\n  body: { idProduto: produtoId, idFornecedor: idFornecedor, descricao: 'Dogma Dropshipping',\n    codigo: 'ALOBFOR_DROP_02', precoCusto: costPrice, precoCompra: costPrice, padrao: true } });\nreturn [{ json: { success: true, sku: sku, idFornecedor: idFornecedor } }];"
